                  "from prismabuild import filesystem_floor as ff;"
                  "from pathlib import Path;"
                  f"cm=ff.floor_locked(Path({str(directory)!r}));"
                  "assert cm.__enter__(); print('held', flush=True); time.sleep(float(sys.argv[1]))")
