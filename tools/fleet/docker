def _container_options(argv: list[str], *, memory_limit: int | None = None) -> tuple[list[str], list[str], str | None]:
    """Retain argv verbatim except cpuset options before IMAGE.

    Return retained argv, normalized label options for ownership checks, and the
    last explicit cpuset (Docker scalar options use the last supplied value).
    Values consumed by another option and tokens after IMAGE are opaque.
    """
    kept: list[str] = []
    options: list[str] = []
    cpuset = None
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--" or not token.startswith("-") or token == "-":
            return [*kept, *argv[index:]], options, cpuset
        end = index + 1
        name, equals, value = token.partition("=")
        if token.startswith("--"):
            if name in CONTAINER_VALUE_OPTIONS:
                if not equals:
                    if end >= len(argv):
                        raise Refused(f"container option {name} requires a value")
                    value = argv[end]
                    end += 1
            elif name not in CONTAINER_FLAGS:
                raise Refused(f"unknown container option {name}; cannot locate image safely")
        else:
            # Docker's short flags may be grouped (-it) and value options may
            # be attached (-v/tmp:/tmp), including after booleans (-itw/tmp).
            offset = 1
            while offset < len(token):
                short = "-" + token[offset]
                offset += 1
                if short in CONTAINER_VALUE_OPTIONS:
                    name = short
                    value = token[offset:]
                    if offset == len(token):
                        if end >= len(argv):
                            raise Refused(f"container option {short} requires a value")
                        value = argv[end]
                        end += 1
                    elif value.startswith("="):
                        value = value[1:]
                    break
                if short not in CONTAINER_FLAGS:
                    raise Refused(f"unknown container option {short}; cannot locate image safely")
                if token[offset:offset + 1] == "=":
                    break  # Explicit short boolean value, left for Docker to validate.
        if name in {"--label", "-l"}:
            options.extend(["--label", value])
        if name == "--cidfile":
            options.extend(["--cidfile", value])
        if memory_limit is not None and name == "--oom-score-adj":
            try:
                adjustment = int(value)
            except ValueError as exc:
                raise Refused("invalid --oom-score-adj value") from exc
            if adjustment == -1000:
                raise Refused("containers may not opt out of the PB group OOM boundary")
        if memory_limit is not None and name == "--restart" and value != "no":
            raise Refused("container restart policies cannot resurrect a completed PB job")
        if memory_limit is not None and name in {"--cgroup-parent", "--oom-kill-disable"}:
            raise Refused(f"{name} cannot override the PB aggregate memory boundary")
        if memory_limit is not None and name in {"--memory", "-m", "--memory-swap"}:
            # A PB parent provides the aggregate hard limit. Preserve any
            # stricter container limit, but never permit unlimited swap.
            if name in {"--memory", "-m"}:
                requested_bytes = _memory_bytes(value)
                options.extend(["--memory", str(min(memory_limit, requested_bytes)
                                                if requested_bytes else memory_limit)])
            if name == "-m" and offset > 2:
                kept.append(token[:offset - 1])
            index = end
            continue
        if name == "--cpuset-cpus":
            cpuset = value
        else:
            kept.extend(argv[index:end])
        index = end
    return kept, options, cpuset


def _reserved_cpuset(requested: str | None) -> str:
    """Intersect an optional Docker mask with kernel-inherited action CPUs."""
    try:
        allowed = set(os.sched_getaffinity(0))
    except (AttributeError, OSError) as exc:
        raise Refused(f"cannot read the action's CPU affinity: {exc}") from exc
    if requested:
        selected: set[int] = set()
        for piece in requested.split(","):
            match = re.fullmatch(r"([0-9]+)(?:-([0-9]+))?", piece)
            if match is None:
                raise Refused(f"invalid --cpuset-cpus mask: {requested!r}")
            try:
                first = int(match[1])
                last = int(match[2]) if match[2] is not None else first
            except ValueError as exc:
                raise Refused("invalid --cpuset-cpus CPU number") from exc
            if first > last:
                raise Refused(f"invalid --cpuset-cpus range: {piece!r}")
            # Bound work by the reserved set even for an enormous input range.
            selected.update(cpu for cpu in allowed if first <= cpu <= last)
        allowed = selected
    if not allowed:
        raise Refused("--cpuset-cpus has no reserved CPUs in the action's affinity")
    return ",".join(str(cpu) for cpu in sorted(allowed))


def _local_daemon(real: str, global_options: list[str]) -> tuple[list[str], dict[str, str]]:
    """Resolve Docker's own effective context, then pin its local endpoint.

    CPU IDs are host-local. A remote context, DOCKER_HOST or SSH endpoint
    cannot safely interpret the reservation. Docker resolves CLI/config/env
    precedence; a second invocation pins that result so a concurrent context
    change cannot redirect the container to another daemon.
    """
    try:
        result = subprocess.run(
            [real, *global_options, "context", "inspect", "--format",
             "{{json .Endpoints.docker.Host}}"],
            capture_output=True, text=True, check=False, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refused(f"cannot resolve the Docker daemon endpoint: {exc}") from exc
    try:
        endpoint = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        endpoint = None
    if (not isinstance(endpoint, str) or not endpoint.startswith("unix:///")
            or endpoint == "unix:///" or "\x00" in endpoint):
        raise Refused("CPU affinity requires a local Unix Docker daemon endpoint; "
                      "remote or unresolved contexts cannot use this host's CPU IDs")
    retained: list[str] = []
    index = 0
    while index < len(global_options):
        token = global_options[index]
        name = token.split("=", 1)[0]
        attached = not token.startswith("--") and token[:2] in GLOBAL_VALUE_OPTIONS
        end = index + (2 if name in GLOBAL_VALUE_OPTIONS and "=" not in token else 1)
        selector = name in {"--context", "-c", "--host", "-H"} or (
            attached and token[:2] in {"-c", "-H"})
        if not selector and token != "--":
            retained.extend(global_options[index:end])
        index = end
    environment = dict(os.environ)
    environment.pop("DOCKER_CONTEXT", None)
    environment.pop("DOCKER_HOST", None)
    return [*retained, "--host", endpoint], environment


def _memory_bytes(value: str) -> int:
    match = re.fullmatch(r"([0-9]+)([bkmgBKMG]?)", value)
    if match is None:
        raise Refused(f"invalid Docker memory value: {value!r}")
    return int(match[1]) * {"": 1, "b": 1, "k": 1024, "m": 1024**2,
                           "g": 1024**3}[match[2].lower()]


def _resource_scope() -> tuple[str, int] | None:
    """Use kernel ancestry, never caller env, for the PB attempt boundary."""
    proc = Path("/proc/self/cgroup")
    root = Path("/sys/fs/cgroup")
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        proc = Path(os.environ.get("PRISMABUILD_CGROUP_FILE") or proc)
        root = Path(os.environ.get("PRISMABUILD_CGROUP_ROOT") or root)
    try:
        raw = proc.read_text()
        for line in raw.splitlines():
            if not line.startswith("0::"):
                continue
            relative = Path(line[3:].lstrip("/"))
            for parent in (relative, *relative.parents):
                if SCOPE_RE.fullmatch(parent.name):
                    limit = int((root / parent / "memory.max").read_text())
                    if limit <= 0:
                        raise ValueError("memory.max is not a positive limit")
                    return parent.name, limit
    except (OSError, ValueError) as exc:
        raise Refused(f"cannot establish the PB cgroup memory boundary: {exc}") from exc
    return None


def _refuse_unaccounted_work(sub: list[str], *, scope: tuple[str, int] | None) -> None:
    if scope is None or not sub:
        return
    verb = sub[0]
    active = verb in {"build", "restart", "unpause", "update"}
    if verb == "container" and len(sub) > 1:
        active = sub[1] in {"restart", "unpause", "update"}
    if verb == "builder" and len(sub) > 1:
        active = sub[1] == "build"
    if verb == "buildx":
        active = not (len(sub) > 1 and sub[1] in {"version", "ls", "inspect"}
                      and not any(token.split("=", 1)[0] == "--bootstrap" for token in sub))
    if verb == "service" and len(sub) > 1:
        active = sub[1] in {"create", "update", "scale", "rollback"}
    if verb == "stack" and len(sub) > 1:
        active = sub[1] in {"deploy", "up"}
    if verb == "compose":
        index = _verb_index(sub[1:], COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS, what="compose")
        active = index is not None and sub[index + 1] in {"build", "exec", "restart", "unpause", "watch"}
    if active:
        raise Refused("this Docker command can start work outside the PB job's memory slice; "
                      "use docker run/create, including an owned container for a builder")


def _owned_exec(real: str, globals: list[str], sub: list[str], scope: tuple[str, int]) -> tuple[list[str], dict]:
    relative = 2 if sub[:2] == ["container", "exec"] else 1
    values = {"--detach-keys", "--env", "--env-file", "--user", "--workdir", "-e", "-u", "-w"}
    flags = {"--detach", "--interactive", "--tty", "-d", "-i", "-t"}
    index = relative
    while index < len(sub):
        token = sub[index]
        if token == "--":
            index += 1
            break
        if not token.startswith("-") or token == "-":
            break
        name, equals, _ = token.partition("=")
        if name == "--privileged":
            raise Refused("docker exec may not add privileged execution")
        if name in values:
            index += 1 if equals else 2
        elif name in flags:
            index += 1
        elif not token.startswith("--"):
            offset = 1
            while offset < len(token):
                short = "-" + token[offset]
                offset += 1
                if short in values:
                    if offset == len(token):
                        index += 1
                    break
                if short not in flags:
                    raise Refused(f"unknown docker exec option {short}")
            index += 1
        else:
            raise Refused(f"unknown docker exec option {name}")
    if index >= len(sub):
        raise Refused("docker exec requires this job's container and a command")
    global_options, environment = _local_daemon(real, globals)
    if global_options[-1] not in {"unix:///var/run/docker.sock", "unix:///run/docker.sock"}:
        raise Refused("PB resource scopes require the local system Docker daemon")
    try:
        result = subprocess.run([real, *global_options, "inspect", sub[index]],
                                capture_output=True, text=True, env=environment, timeout=10, check=False)
        rows = json.loads(result.stdout) if result.returncode == 0 else []
        row = rows[0] if isinstance(rows, list) and len(rows) == 1 else {}
        labels = row.get("Config", {}).get("Labels") or {}
        cid = row.get("Id", "")
        if (not re.fullmatch(r"[a-f0-9]{64}", cid)
                or labels.get(SCOPE_LABEL) != scope[0]
                or labels.get(LABEL) != os.environ.get(OWNER_ENV)
                or row.get("HostConfig", {}).get("CgroupParent") != scope[0]
                or row.get("State", {}).get("Running") is not True):
            raise Refused("docker exec target is not a running container in this exact PB memory slice")
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        raise Refused(f"cannot verify docker exec container ownership: {exc}") from exc
    # Pin the immutable id after inspection; a recycled container name must not
    # redirect this command into another job between inspect and exec.
    return [*global_options, *sub[:index], cid, *sub[index + 1:]], environment


def _container_intent(scope: str, *, ticket: str | None = None) -> dict:
    # Published fleet tools are flattened; source checkouts retain tools/fleet.
    source = Path(__file__).resolve().parents[1] / "src"
    if not source.is_dir():
        source = Path(__file__).resolve().parents[2] / "src"
    sys.path.insert(0, str(source))
    from prismabuild.resource_scope import BROKER_SOCKET, broker_request
    endpoint = BROKER_SOCKET
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        endpoint = Path(os.environ.get("PRISMABUILD_RESOURCE_SOCKET") or endpoint)
    request = {"op": "container_begin" if ticket is None else "container_end",
               "scope_id": scope}
    if ticket is not None:
        request["ticket"] = ticket
    try:
        response = broker_request(request, socket_path=endpoint)
        if ticket is None and re.fullmatch(r"[a-f0-9]{64}", str(response.get("ticket", ""))) is None:
            raise OSError("broker returned no valid container intent ticket")
        return response
    except (OSError, ValueError) as exc:
        raise Refused(f"cannot register container creation with the PB resource broker: {exc}") from exc


def _bounded_seconds(name: str, default: float, maximum: float) -> float:
    """A positive, finite, capped number of seconds from the environment."""
    raw = os.environ.get(name, "")
    try:
        value = float(raw)
    except ValueError:
        return default
    if not math.isfinite(value) or value <= 0:
        return default
    return min(value, maximum)


def _stop_grace() -> float:
    return _bounded_seconds(GRACE_ENV, DEFAULT_GRACE_S, MAX_GRACE_S)


def _kill_wait() -> float:
    return _bounded_seconds(KILL_WAIT_ENV, DEFAULT_KILL_WAIT_S, MAX_KILL_WAIT_S)


def _daemon(real: str, global_options: list[str], environment: dict, args: list[str],
            *, timeout: float):
    """One bounded call to the real client: ``(code, stdout, stderr)``.

    ``code`` is None when the call could not run or ran out of time, which is
    never an empty answer.
    """
    if timeout <= 0.05:
        return None, "", ""
    try:
        done = subprocess.run([real, *global_options, *args], env=environment,
                              capture_output=True, text=True, check=False,
                              timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None, "", ""
    return done.returncode, done.stdout, done.stderr


def _owned_by_this_attempt(row: dict, owner: str, scope, nonce: str) -> bool:
    """The existing ownership contract (see ``_owned_exec``), plus this call's nonce."""
    labels = (row.get("Config") or {}).get("Labels") or {}
    if labels.get(LABEL) != owner or labels.get(SHIM_LABEL) != nonce:
        return False
    if scope is not None:
        if (labels.get(SCOPE_LABEL) != scope[0]
                or (row.get("HostConfig") or {}).get("CgroupParent") != scope[0]):
            return False
    return True


def _final_state(row: dict | None, state: str) -> dict:
    info = (row or {}).get("State") or {}
    running = bool(info.get("Running")) if state == "present" else None
    return {"found": state == "present", "inspect": state, "running": running,
            "status": info.get("Status"), "exit_code": info.get("ExitCode"),
            "oom_killed": info.get("OOMKilled"),
            "finished_at": info.get("FinishedAt")}


def _write_receipt(path: Path, receipt: dict) -> None:
    """Atomic and best-effort: a receipt that cannot be written never changes the stop."""
    try:
        temporary = path.with_name(path.name + f".tmp{os.getpid()}")
        temporary.write_text(json.dumps(receipt) + "\n", encoding="utf-8")
        os.replace(temporary, path)
    except OSError:
        pass


class _Stop:
    """One stop: every daemon call and wait shares one absolute deadline (#1599).

    The deadline is the first signal plus the grace plus a tail that covers the
    ownership query, the kill and the check afterwards.  The defaults sum to
    four seconds, inside the five a guard may allow between TERM and its own
    KILL, and no single daemon call may outlast what remains.
    """

    def __init__(self, real, global_options, environment, grace, tail):
        self.real, self.global_options, self.environment = real, global_options, environment
        self.grace_end = time.monotonic() + grace
        self.hard_end = self.grace_end + tail

    def left(self) -> float:
        return self.hard_end - time.monotonic()

    def call(self, args):
        return _daemon(self.real, self.global_options, self.environment, args,
                       timeout=min(DAEMON_CALL_S, self.left()))

    def container_id(self, cidfile: Path, nonce: str):
        """The id of the container THIS call created, and how it was found.

        The cidfile is the client's own record of the id.  When it is absent
        the call's own label finds the container: the nonce names this call and
        no other.  A failed query is "unreadable", never "no container".
        """
        try:
            text = cidfile.read_text(encoding="utf-8").strip()
        except OSError:
            text = ""
        if re.fullmatch(r"[0-9a-f]{12,64}", text):
            return text, "cidfile"
        code, out, _ = self.call(["ps", "-aq", "--no-trunc", "--filter",
                                  f"label={SHIM_LABEL}={nonce}"])
        if code != 0:
            return None, "unreadable"
        found = [line for line in out.split() if re.fullmatch(r"[0-9a-f]{12,64}", line)]
        return (found[0], "label") if len(found) == 1 else (None, None)

    def inspect(self, cid: str):
        """``(state, row)``: present, absent or unreadable.

        Absent needs the daemon's own "No such object": a connection or
        permission failure is unreadable, and unreadable is never a stop.
        """
        code, out, err = self.call(["inspect", cid])
        if code is None:
            return "unreadable", None
        if code != 0:
            absent = re.search(r"no such (object|container)", err, re.I) is not None
            return ("absent" if absent else "unreadable"), None
        try:
            rows = json.loads(out)
        except ValueError:
            return "unreadable", None
        if not isinstance(rows, list) or len(rows) != 1 or not isinstance(rows[0], dict):
            return "unreadable", None
        return "present", rows[0]

    def kill(self, cid: str, name: str) -> bool:
        """True only when Docker accepted the signal."""
        code, _, _ = self.call(["kill", "--signal", name, cid])
        return code == 0


def _run_relayed(real: str, args: list[str], environment: dict, *, owner: str,
                 scope, global_options: list[str], nonce: str, cidfile: Path,
                 receipt_path: Path) -> int:
    """Run the real client; on TERM, INT or HUP stop the workload it started (#1599).

    The handlers are installed BEFORE the client starts and stay armed until
    the receipt is written, so no signal in the launch window or during the
    stop is lost or ends the shim early.  The first signal goes to the client,
    which relays it to the container's main process.  After the grace the exact
    container this call created, shown by ``inspect`` to carry the owner label,
    the call's nonce and, when scoped, the scope label and cgroup parent, is
    killed; a refused kill is retried and never recorded as a kill.  The shim
    then checks the daemon until the container is proved stopped or absent, or
    until the one absolute deadline.  It returns 128+signal only when a stop is
    proved.  Anything else (a container still running, a daemon that cannot be
    asked, a container that is not this attempt's) returns STOP_FAILED_EXIT and
    a receipt that says so: a guard must never read "terminated" while the
    workload lives.  Nothing is stopped by name.
    """
    received: list[tuple[int, float]] = []

    def note(number, _frame):
        received.append((number, time.time()))

    previous = {number: signal.signal(number, note) for number in RELAYED_SIGNALS}
    try:
        grace, kill_wait = _stop_grace(), _kill_wait()
        escalation = {"container_killed": False, "client_killed": False,
                      "kill_rejected": 0}
        started = time.time()
        child = subprocess.Popen([real, *args], env=environment)
        stop = None
        forwarded = 0
        first_unix = None
        while child.poll() is None:
            while forwarded < len(received):
                number, at = received[forwarded]
                forwarded += 1
                if stop is None:
                    first_unix = at
                    stop = _Stop(real, global_options, environment, grace, STOP_TAIL_S)
                    _write_receipt(receipt_path, {
                        "schema": RECEIPT_SCHEMA, "owner": owner, "nonce": nonce,
                        "outcome": "signalled", "container_id": None,
                        "signals": [{"signal": int(n), "at_unix": t} for n, t in received],
                        "grace_s": grace, "kill_wait_s": kill_wait})
                try:
                    child.send_signal(number)
                except OSError:
                    pass
            if stop is not None and time.monotonic() >= stop.grace_end:
                break
            time.sleep(0.02)
        if not received:
            return child.returncode if child.returncode is not None else 1
        if stop is None:           # the client ended just as the signal landed
            first_unix = received[0][1]
            stop = _Stop(real, global_options, environment, grace, STOP_TAIL_S)

        cid = found_by = None
        if child.poll() is None:
            # The client outlived the grace: stop the exact container first.
            cid, found_by = stop.container_id(cidfile, nonce)
            if cid is not None:
                state, row = stop.inspect(cid)
                if state == "present" and _owned_by_this_attempt(row, owner, scope, nonce):
                    if stop.kill(cid, "KILL"):
                        escalation["container_killed"] = True
                    else:
                        escalation["kill_rejected"] += 1
            wait_until = min(time.monotonic() + kill_wait, stop.hard_end)
            while child.poll() is None and time.monotonic() < wait_until:
                time.sleep(0.02)
            if child.poll() is None:
                child.kill()
                escalation["client_killed"] = True
                try:
                    child.wait(timeout=max(0.05, min(0.5, stop.left())))
                except subprocess.TimeoutExpired:
                    pass
        code = child.returncode

        # The client is gone.  Make sure the container is: poll the daemon to
        # the deadline, relaying the signal first and the kill once the grace
        # has passed, and call it stopped only on a successful query.
        if cid is None:
            cid, found_by = stop.container_id(cidfile, nonce)
            # An empty answer is not proof that no container will exist: a
            # create request the client already sent can still complete at the
            # daemon after the client is gone.  Keep watching for the call's
            # label until the deadline, and stop whatever appears.
            while cid is None and found_by is None and stop.left() > 0.3:
                time.sleep(0.2)
                cid, found_by = stop.container_id(cidfile, nonce)
        outcome = "unknown" if found_by == "unreadable" else "creation_unresolved"
        final = {"found": False, "inspect": None, "running": None}
        if cid is not None:
            relayed = False
            last_seen = None        # the last successful observation of a live container
            while True:
                state, row = stop.inspect(cid)
                final = _final_state(row, state)
                if state == "present":
                    last_seen = final if final["running"] else None
                if state == "absent":
                    outcome = "killed" if escalation["container_killed"] else "stopped"
                    break
                if state == "present":
                    if not _owned_by_this_attempt(row, owner, scope, nonce):
                        outcome = "not_owned"
                        break
                    if not final["running"]:
                        outcome = "killed" if escalation["container_killed"] else "stopped"
                        break
                    if not relayed:
                        relayed = True
                        stop.kill(cid, signal.Signals(received[0][0]).name[3:])
                    elif time.monotonic() >= stop.grace_end:
                        if stop.kill(cid, "KILL"):
                            escalation["container_killed"] = True
                        else:
                            escalation["kill_rejected"] += 1
                if stop.left() <= 0.05:
                    # Last seen running and never proved stopped is still_running,
                    # even when the final query ran out of time; a container that
                    # was never successfully inspected is unknown.
                    if state != "present" and last_seen is not None:
                        final = dict(last_seen, stale=True)
                    outcome = "still_running" if last_seen is not None else "unknown"
                    break
                time.sleep(0.1)
        proved = outcome in ("stopped", "killed")
        _write_receipt(receipt_path, {
            "schema": RECEIPT_SCHEMA, "owner": owner, "nonce": nonce,
            "scope": scope[0] if scope else None,
            "container_id": cid, "found_by": found_by, "outcome": outcome,
            "signals": [{"signal": int(n), "at_unix": t} for n, t in received],
            "started_unix": started, "finished_unix": time.time(),
            "client_exit_code": code, "grace_s": grace, "kill_wait_s": kill_wait,
            "stop_tail_s": STOP_TAIL_S, "escalation": escalation,
            "container_final": final, "stop_proved": proved})
        return 128 + int(received[0][0]) if proved else STOP_FAILED_EXIT
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def main() -> int:
    argv = sys.argv[1:]
    owner = os.environ.get(OWNER_ENV, "")
    marker_raw = os.environ.get(MARKER_ENV, "")
    real = _real_docker()
    if not owner and not marker_raw:
        os.execv(real, [real, *argv])
    if len(owner) != 64 or any(ch not in "0123456789abcdef" for ch in owner):
        sys.stderr.write(f"docker shim: {OWNER_ENV} is not a 64-hex digest\n")
        return 125
    if not marker_raw:
        sys.stderr.write(f"docker shim: {MARKER_ENV} is missing\n")
        return 125
    try:
        command = _verb_index(argv, GLOBAL_VALUE_OPTIONS, GLOBAL_FLAGS,
                              what="global")
        sub = [] if command is None else argv[command:]
        unowned = _starts_unowned_container(sub)
        if os.environ.get("PRISMABUILD_PROFILE_NSYS") == "1" and (
                _creation_index(sub) is not None or unowned
                or sub[:1] == ["exec"] or sub[:2] == ["container", "exec"]):
            raise Refused(
                "--profile nsys cannot trace CUDA work launched by the Docker "
                "daemon; container execution is refused before contacting it. "
                "Run the CUDA workload as a native child under --profile nsys, "
                "or omit that mode and explicitly instrument inside the "
                "admitted container (for PyTorch, use --profile torch and "
                "forward/mount PRISMABUILD_PROFILE_TORCH_OUT). Keep using "
                "PB's Docker shim for resource scope and CPU affinity.")
        route = _container_route(sub)
        if os.environ.get(SAMPLE_GUARD_ENV) == "1" and route is not None:
            recorded = _record_sample_route(
                os.environ.get(SAMPLE_MARKER_ENV, ""), route)
            raise Refused(
                f"--profile sample cannot cover a workload started by the "
                f"Docker daemon ({route}); py-spy follows the action's own "
                "process tree, and a process the daemon starts is not in it. "
                "The container route was refused before contacting the daemon, "
                "and the profile record will say it does not cover a container "
                "workload."
                + ("" if recorded else
                   " The attempted route could not be written to the profile "
                   "marker, which leaves the profile's coverage unknown rather "
                   "than clean; treat this action as unprofiled.")
                + " Run the workload as a native child under --profile sample, "
                "or omit that mode and instrument inside the admitted container "
                "(for PyTorch, use --profile torch and forward/mount "
                "PRISMABUILD_PROFILE_TORCH_OUT). Keep using PB's Docker shim "
                "for resource scope and CPU affinity.")
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    if unowned:
        sys.stderr.write(
            "docker shim: start/compose-up cannot attach PrismaBuild's owner "
            "label; use docker run/create inside this action\n")
        return 125

    try:
        scope = _resource_scope()
        _refuse_unaccounted_work(sub, scope=scope)
        if scope and (sub[:1] == ["exec"] or sub[:2] == ["container", "exec"]):
            forwarded, environment = _owned_exec(real, argv[:command], sub, scope)
            os.execvpe(real, [real, *forwarded], environment)
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    relative = _creation_index(sub)
    if relative is None:
        os.execv(real, [real, *argv])
    insertion = command + relative
    try:
        creation, options, requested = _container_options(
            argv[insertion:], memory_limit=scope[1] if scope else None)
        cpuset = _reserved_cpuset(requested)
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    if _has_reserved_label(options):
        sys.stderr.write(
            f"docker shim: callers may not set the reserved {LABEL} or "
            f"{JOB_LABEL} label\n")
        return 125

    try:
        global_options, environment = _local_daemon(real, argv[:command])
        if scope and global_options[-1] not in {"unix:///var/run/docker.sock", "unix:///run/docker.sock"}:
            raise Refused("PB resource scopes require the local system Docker daemon")
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125

    marker = Path(marker_raw)
    marker.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(marker, os.O_RDWR | os.O_CREAT, 0o644)
    cid_directory = None
    try:
        # Held until the Docker CLI returns or this action is killed.  Cleanup
        # acquires the same lock before querying the daemon, so it cannot race
        # a container creation request still in flight.
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        os.ftruncate(descriptor, 0)
        os.write(descriptor, owner.encode() + b"\n")
        os.fsync(descriptor)
        labels = ["--label", f"{LABEL}={owner}"]
        nonce = os.urandom(16).hex()
        job = _slurm_job_id()
        if job:
            labels += ["--label", f"{JOB_LABEL}={job}"]
        containment = []
        if scope:
            unit, limit = scope
            labels += ["--label", f"{SCOPE_LABEL}={unit}"]
            memory_options = [value for index, value in enumerate(options)
                              if index and options[index - 1] == "--memory"]
            limit = int(memory_options[-1]) if memory_options else limit
            containment = ["--cgroup-parent", unit, "--memory", str(limit),
                           "--memory-swap", str(limit)]
        labels += ["--label", f"{SHIM_LABEL}={nonce}"]
        # The client's own record of the container id, for the stop path.  A
        # cidfile the caller named is theirs and is kept; ours is made fresh,
        # because Docker refuses a cidfile that exists, and is removed after.
        caller_cidfile = [options[i + 1] for i, token in enumerate(options)
                          if token == "--cidfile" and i + 1 < len(options)]
        if caller_cidfile:
            cidfile, cid_option = Path(caller_cidfile[-1]), []
        else:
            cid_directory = Path(tempfile.mkdtemp(prefix="pbdocker-cid-"))
            cidfile = cid_directory / "cid"
            cid_option = ["--cidfile", str(cidfile)]
        labelled = [*global_options, *sub[:relative], *labels, *containment,
                    "--cpuset-cpus", cpuset, *cid_option, *creation]
        try:
            ticket = _container_intent(scope[0])["ticket"] if scope else None
            receipt_path = marker.with_name(f"{marker.name}.stop-{nonce[:12]}.json")
            result = subprocess.CompletedProcess(
                [real, *labelled], _run_relayed(
                    real, labelled, environment, owner=owner, scope=scope,
                    global_options=global_options, nonce=nonce, cidfile=cidfile,
                    receipt_path=receipt_path))
            # Only CLI success proves the daemon operation settled. A nonzero
            # exit can follow a connection failure after daemon acceptance.
            # Retain its pending ticket (also for an ordinary user-command
            # failure), so release keeps a frozen tombstone for late creation.
            if ticket is not None and result.returncode == 0:
                _container_intent(scope[0], ticket=ticket)
            return result.returncode
        except Refused as refusal:
            sys.stderr.write(f"docker shim: {refusal}\n")
            return 125
    finally:
        os.close(descriptor)
        if cid_directory is not None:
            shutil.rmtree(cid_directory, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
