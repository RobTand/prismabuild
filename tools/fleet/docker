#!/usr/bin/python3
"""Docker CLI shim that binds containers to one action and its reserved CPUs."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys


OWNER_ENV = "PRISMABUILD_CONTAINER_OWNER"
MARKER_ENV = "PRISMABUILD_CONTAINER_MARKER"
LABEL = "prismabuild.action"
SCOPE_LABEL = "prismabuild.scope"
SCOPE_RE = re.compile(r"prismabuild-job[a-f0-9]{32}\.slice")

#: A second label naming the SLURM job this container was created inside.
#:
#: The owner label is the action's identity, and under the pull queue that was
#: also one execution: the queue handed a key to one worker at a time.  SLURM
#: has no such claim -- an attached ``pbrun`` re-submits a key that already has
#: a job in flight -- so two jobs of one action can run on one node, share the
#: owner label, and the first job's Epilog removes the second job's containers.
#:
#: The job id is read from this process's kernel-owned cgroup and NOT from the
#: environment: ``proctrack/cgroup`` puts every process of a job under
#: ``job_<id>`` and nothing in the job can move itself out, whereas anything
#: can export a variable.  It is the rule ``core._slurm_job_from_cgroup``
#: already applies to worker attestation, and the regex below is that one.
#: Outside a job cgroup -- the pull queue, a hand-run action -- there is no
#: second label and nothing changes.
JOB_LABEL = "prismabuild.job"
CGROUP_JOB_RE = re.compile(r"(?:^|/)job_([1-9][0-9]*)(?:[./]|$)")


def _slurm_job_id() -> str:
    """The job whose cgroup holds this process, or "" when there is not one.

    Silent on every failure by design: a shim that refused to start a container
    because it could not read ``/proc`` would take the pull queue down with it.
    An unreadable or ambiguous cgroup yields no label, which the Epilog reads
    as "not this job's container" and leaves alone -- a leaked container rather
    than somebody else's removed.
    """

    # The path is overridable only under the same testing gate the real docker
    # binary is, and for the same reason: a test cannot give this process a
    # SLURM job cgroup, and nothing in production reads the override.
    path = Path("/proc/self/cgroup")
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        path = Path(os.environ.get("PRISMABUILD_CGROUP_FILE") or path)
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError:
        return ""
    jobs = set()
    for line in raw.splitlines():
        fields = line.split(":", 2)
        if len(fields) != 3:
            continue
        match = CGROUP_JOB_RE.search(fields[2])
        if match is not None:
            jobs.add(match.group(1))
    return jobs.pop() if len(jobs) == 1 else ""


def _real_docker() -> str:
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        return os.environ.get("PRISMABUILD_DOCKER_REAL", "/usr/bin/docker")
    return "/usr/bin/docker"


class Refused(Exception):
    """A command this shim will not hand to Docker, with the reason."""


#: Docker's own global options, which may precede the subcommand.
#:
#: The shim used to read ``argv[0]`` as the subcommand, so every documented
#: spelling that puts an option first hid the command behind it: ``docker
#: --context default run -d IMAGE`` reached the daemon with no owner label, no
#: job label and no marker, and a detached container created that way is one
#: ``pool.cleanup_action_containers`` and the Epilog both query by label and
#: therefore never find.  ``docker --context default start`` and ``docker
#: compose -f f.yml up -d`` escaped the refusals for the same reason.  Options
#: are split by arity because that is the only thing the shim needs from them:
#: where the command begins.
GLOBAL_VALUE_OPTIONS = frozenset({
    "--config", "-c", "--context", "-H", "--host", "-l", "--log-level",
    "--tlscacert", "--tlscert", "--tlskey",
})
GLOBAL_FLAGS = frozenset({
    "-D", "--debug", "--tls", "--tlsverify", "-v", "--version", "-h", "--help",
})

#: Compose's own options, which sit between ``compose`` and its verb.
COMPOSE_VALUE_OPTIONS = frozenset({
    "--ansi", "--env-file", "-f", "--file", "--parallel", "--profile",
    "--progress", "--project-directory", "-p", "--project-name",
})
COMPOSE_FLAGS = frozenset({"--all-resources", "--compatibility", "--dry-run"})

#: Compose verbs that create or start containers.  Compose owns the labels on
#: what it creates, so none of them can carry this action's owner label, and
#: all four are the refusal ``compose up`` already was.
COMPOSE_STARTS = frozenset({"up", "run", "create", "start"})


def _verb_index(argv: list[str], value_options: frozenset[str],
                flags: frozenset[str], *, what: str) -> int | None:
    """Index of the first token past these options, or None if there is none.

    Raises ``Refused`` on an option the shim does not know.  Guessing an
    unknown option's arity is what the old fixed-position read did by
    accident: parse one token out and an image name reads as a subcommand, or
    a ``start`` reads as an option's value.  A refusal names the option and
    the operator adds it to the table above; a guess loses a container.
    """

    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--":
            return index + 1 if index + 1 < len(argv) else None
        if not token.startswith("-") or token == "-":
            return index
        name = token.split("=", 1)[0]
        if name in value_options:
            index += 1 if "=" in token else 2
            continue
        if name in flags:
            index += 1
            continue
        if not token.startswith("--") and token[:2] in value_options:
            index += 1                     # attached: -cdefault, -Hunix:///x
            continue
        raise Refused(
            f"{what} option {token} is not one this shim knows, so it cannot "
            f"tell where the command begins; add it to the shim's option "
            f"table or run this without the option")
    return None


def _creation_index(argv: list[str]) -> int | None:
    """Where a container command's own options begin, or None.

    ``argv`` is the subcommand and everything after it, Docker's globals
    already consumed by the caller.
    """

    if argv and argv[0] in {"run", "create"}:
        return 1
    if len(argv) >= 2 and argv[0] == "container" and argv[1] in {"run", "create"}:
        return 2
    return None


def _starts_unowned_container(argv: list[str]) -> bool:
    """True for a lifecycle form that cannot be given this action's label."""

    if argv and argv[0] == "start":
        return True
    if len(argv) >= 2 and argv[0] == "container" and argv[1] == "start":
        return True
    if argv and argv[0] == "compose":
        verb = _verb_index(argv[1:], COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS,
                           what="compose")
        return verb is not None and argv[1 + verb] in COMPOSE_STARTS
    return False


def _label_values(argv: list[str]):
    """Every ``--label`` value on a container command, however it is spelled.

    ``--label=prismabuild.action`` (a key with no value) and the attached
    ``-lprismabuild.job=9999`` are the same fixed-token assumption the
    subcommand read had: both set a reserved label and neither was seen.
    """

    index = 0
    while index < len(argv):
        token = argv[index]
        if token in {"--label", "-l"}:
            if index + 1 < len(argv):
                yield argv[index + 1]
            index += 2
            continue
        for prefix in ("--label=", "-l=", "-l"):
            if token.startswith(prefix) and len(token) > len(prefix):
                yield token[len(prefix):]
                break
        index += 1


def _has_reserved_label(argv: list[str]) -> bool:
    for value in _label_values(argv):
        if value.split("=", 1)[0] in {LABEL, JOB_LABEL, SCOPE_LABEL}:
            return True
    return False


# Arity from Docker's run/create CLI contract. Unknown options fail closed
# instead of guessing where IMAGE (and arbitrary container argv) begins.
# https://docs.docker.com/reference/cli/docker/container/run/
CONTAINER_VALUE_OPTIONS = frozenset("""
--add-host --annotation -a --attach --blkio-weight --blkio-weight-device --cap-add
--cap-drop --cgroup-parent --cgroupns --cidfile --cpu-count --cpu-percent --cpu-period
--cpu-quota --cpu-rt-period --cpu-rt-runtime -c --cpu-shares --cpus --cpuset-cpus
--cpuset-mems --detach-keys --device --device-cgroup-rule --device-read-bps
--device-read-iops --device-write-bps --device-write-iops --dns --dns-option
--dns-search --domainname --entrypoint -e --env --env-file --expose --gpus --group-add
--health-cmd --health-interval --health-retries --health-start-interval
--health-start-period --health-timeout -h --hostname --io-maxbandwidth --io-maxiops --ip
--ip6 --ipc --isolation -l --label --label-file --link --link-local-ip --log-driver
--log-opt --mac-address -m --memory --memory-reservation --memory-swap
--memory-swappiness --mount --name --network --network-alias --oom-score-adj --pid
--pids-limit --platform -p --publish --pull --restart --runtime --security-opt
--shm-size --stop-signal --stop-timeout --storage-opt --sysctl --tmpfs --ulimit --umask
-u --user --userns --uts -v --volume --volume-driver --volumes-from -w --workdir --net
--net-alias --dns-opt
""".split())
CONTAINER_FLAGS = frozenset("""
-d --detach --help --init -i --interactive --no-healthcheck --oom-kill-disable
--privileged -P --publish-all -q --quiet --read-only --rm --sig-proxy -t --tty
--use-api-socket
""".split())


def _container_options(argv: list[str], *, memory_limit: int | None = None) -> tuple[list[str], list[str], str | None]:
    """Retain argv verbatim except cpuset options before IMAGE.

    Return retained argv, normalized label options for ownership checks, and the
    last explicit cpuset (Docker scalar options use the last supplied value).
    Values consumed by another option and tokens after IMAGE are opaque.
    """
    kept: list[str] = []
    options: list[str] = []
    cpuset = None
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--" or not token.startswith("-") or token == "-":
            return [*kept, *argv[index:]], options, cpuset
        end = index + 1
        name, equals, value = token.partition("=")
        if token.startswith("--"):
            if name in CONTAINER_VALUE_OPTIONS:
                if not equals:
                    if end >= len(argv):
                        raise Refused(f"container option {name} requires a value")
                    value = argv[end]
                    end += 1
            elif name not in CONTAINER_FLAGS:
                raise Refused(f"unknown container option {name}; cannot locate image safely")
        else:
            # Docker's short flags may be grouped (-it) and value options may
            # be attached (-v/tmp:/tmp), including after booleans (-itw/tmp).
            offset = 1
            while offset < len(token):
                short = "-" + token[offset]
                offset += 1
                if short in CONTAINER_VALUE_OPTIONS:
                    name = short
                    value = token[offset:]
                    if offset == len(token):
                        if end >= len(argv):
                            raise Refused(f"container option {short} requires a value")
                        value = argv[end]
                        end += 1
                    elif value.startswith("="):
                        value = value[1:]
                    break
                if short not in CONTAINER_FLAGS:
                    raise Refused(f"unknown container option {short}; cannot locate image safely")
                if token[offset:offset + 1] == "=":
                    break  # Explicit short boolean value, left for Docker to validate.
        if name in {"--label", "-l"}:
            options.extend(["--label", value])
        if memory_limit is not None and name == "--oom-score-adj":
            try:
                adjustment = int(value)
            except ValueError as exc:
                raise Refused("invalid --oom-score-adj value") from exc
            if adjustment == -1000:
                raise Refused("containers may not opt out of the PB group OOM boundary")
        if memory_limit is not None and name == "--restart" and value != "no":
            raise Refused("container restart policies cannot resurrect a completed PB job")
        if memory_limit is not None and name in {"--cgroup-parent", "--oom-kill-disable"}:
            raise Refused(f"{name} cannot override the PB aggregate memory boundary")
        if memory_limit is not None and name in {"--memory", "-m", "--memory-swap"}:
            # A PB parent provides the aggregate hard limit. Preserve any
            # stricter container limit, but never permit unlimited swap.
            if name in {"--memory", "-m"}:
                requested_bytes = _memory_bytes(value)
                options.extend(["--memory", str(min(memory_limit, requested_bytes)
                                                if requested_bytes else memory_limit)])
            if name == "-m" and offset > 2:
                kept.append(token[:offset - 1])
            index = end
            continue
        if name == "--cpuset-cpus":
            cpuset = value
        else:
            kept.extend(argv[index:end])
        index = end
    return kept, options, cpuset


def _reserved_cpuset(requested: str | None) -> str:
    """Intersect an optional Docker mask with kernel-inherited action CPUs."""
    try:
        allowed = set(os.sched_getaffinity(0))
    except (AttributeError, OSError) as exc:
        raise Refused(f"cannot read the action's CPU affinity: {exc}") from exc
    if requested:
        selected: set[int] = set()
        for piece in requested.split(","):
            match = re.fullmatch(r"([0-9]+)(?:-([0-9]+))?", piece)
            if match is None:
                raise Refused(f"invalid --cpuset-cpus mask: {requested!r}")
            try:
                first = int(match[1])
                last = int(match[2]) if match[2] is not None else first
            except ValueError as exc:
                raise Refused("invalid --cpuset-cpus CPU number") from exc
            if first > last:
                raise Refused(f"invalid --cpuset-cpus range: {piece!r}")
            # Bound work by the reserved set even for an enormous input range.
            selected.update(cpu for cpu in allowed if first <= cpu <= last)
        allowed = selected
    if not allowed:
        raise Refused("--cpuset-cpus has no reserved CPUs in the action's affinity")
    return ",".join(str(cpu) for cpu in sorted(allowed))


def _local_daemon(real: str, global_options: list[str]) -> tuple[list[str], dict[str, str]]:
    """Resolve Docker's own effective context, then pin its local endpoint.

    CPU IDs are host-local. A remote context, DOCKER_HOST or SSH endpoint
    cannot safely interpret the reservation. Docker resolves CLI/config/env
    precedence; a second invocation pins that result so a concurrent context
    change cannot redirect the container to another daemon.
    """
    try:
        result = subprocess.run(
            [real, *global_options, "context", "inspect", "--format",
             "{{json .Endpoints.docker.Host}}"],
            capture_output=True, text=True, check=False, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refused(f"cannot resolve the Docker daemon endpoint: {exc}") from exc
    try:
        endpoint = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        endpoint = None
    if (not isinstance(endpoint, str) or not endpoint.startswith("unix:///")
            or endpoint == "unix:///" or "\x00" in endpoint):
        raise Refused("CPU affinity requires a local Unix Docker daemon endpoint; "
                      "remote or unresolved contexts cannot use this host's CPU IDs")
    retained: list[str] = []
    index = 0
    while index < len(global_options):
        token = global_options[index]
        name = token.split("=", 1)[0]
        attached = not token.startswith("--") and token[:2] in GLOBAL_VALUE_OPTIONS
        end = index + (2 if name in GLOBAL_VALUE_OPTIONS and "=" not in token else 1)
        selector = name in {"--context", "-c", "--host", "-H"} or (
            attached and token[:2] in {"-c", "-H"})
        if not selector and token != "--":
            retained.extend(global_options[index:end])
        index = end
    environment = dict(os.environ)
    environment.pop("DOCKER_CONTEXT", None)
    environment.pop("DOCKER_HOST", None)
    return [*retained, "--host", endpoint], environment


def _memory_bytes(value: str) -> int:
    match = re.fullmatch(r"([0-9]+)([bkmgBKMG]?)", value)
    if match is None:
        raise Refused(f"invalid Docker memory value: {value!r}")
    return int(match[1]) * {"": 1, "b": 1, "k": 1024, "m": 1024**2,
                           "g": 1024**3}[match[2].lower()]


def _resource_scope() -> tuple[str, int] | None:
    """Use kernel ancestry, never caller env, for the PB attempt boundary."""
    proc = Path("/proc/self/cgroup")
    root = Path("/sys/fs/cgroup")
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        proc = Path(os.environ.get("PRISMABUILD_CGROUP_FILE") or proc)
        root = Path(os.environ.get("PRISMABUILD_CGROUP_ROOT") or root)
    try:
        raw = proc.read_text()
        for line in raw.splitlines():
            if not line.startswith("0::"):
                continue
            relative = Path(line[3:].lstrip("/"))
            for parent in (relative, *relative.parents):
                if SCOPE_RE.fullmatch(parent.name):
                    limit = int((root / parent / "memory.max").read_text())
                    if limit <= 0:
                        raise ValueError("memory.max is not a positive limit")
                    return parent.name, limit
    except (OSError, ValueError) as exc:
        raise Refused(f"cannot establish the PB cgroup memory boundary: {exc}") from exc
    return None


def _refuse_unaccounted_work(sub: list[str], *, scope: tuple[str, int] | None) -> None:
    if scope is None or not sub:
        return
    verb = sub[0]
    active = verb in {"build", "restart", "unpause", "update"}
    if verb == "container" and len(sub) > 1:
        active = sub[1] in {"restart", "unpause", "update"}
    if verb == "builder" and len(sub) > 1:
        active = sub[1] == "build"
    if verb == "buildx":
        active = not (len(sub) > 1 and sub[1] in {"version", "ls", "inspect"}
                      and not any(token.split("=", 1)[0] == "--bootstrap" for token in sub))
    if verb == "service" and len(sub) > 1:
        active = sub[1] in {"create", "update", "scale", "rollback"}
    if verb == "stack" and len(sub) > 1:
        active = sub[1] in {"deploy", "up"}
    if verb == "compose":
        index = _verb_index(sub[1:], COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS, what="compose")
        active = index is not None and sub[index + 1] in {"build", "exec", "restart", "unpause", "watch"}
    if active:
        raise Refused("this Docker command can start work outside the PB job's memory slice; "
                      "use docker run/create, including an owned container for a builder")


def _owned_exec(real: str, globals: list[str], sub: list[str], scope: tuple[str, int]) -> tuple[list[str], dict]:
    relative = 2 if sub[:2] == ["container", "exec"] else 1
    values = {"--detach-keys", "--env", "--env-file", "--user", "--workdir", "-e", "-u", "-w"}
    flags = {"--detach", "--interactive", "--tty", "-d", "-i", "-t"}
    index = relative
    while index < len(sub):
        token = sub[index]
        if token == "--":
            index += 1
            break
        if not token.startswith("-") or token == "-":
            break
        name, equals, _ = token.partition("=")
        if name == "--privileged":
            raise Refused("docker exec may not add privileged execution")
        if name in values:
            index += 1 if equals else 2
        elif name in flags:
            index += 1
        elif not token.startswith("--"):
            offset = 1
            while offset < len(token):
                short = "-" + token[offset]
                offset += 1
                if short in values:
                    if offset == len(token):
                        index += 1
                    break
                if short not in flags:
                    raise Refused(f"unknown docker exec option {short}")
            index += 1
        else:
            raise Refused(f"unknown docker exec option {name}")
    if index >= len(sub):
        raise Refused("docker exec requires this job's container and a command")
    global_options, environment = _local_daemon(real, globals)
    if global_options[-1] not in {"unix:///var/run/docker.sock", "unix:///run/docker.sock"}:
        raise Refused("PB resource scopes require the local system Docker daemon")
    try:
        result = subprocess.run([real, *global_options, "inspect", sub[index]],
                                capture_output=True, text=True, env=environment, timeout=10, check=False)
        rows = json.loads(result.stdout) if result.returncode == 0 else []
        row = rows[0] if isinstance(rows, list) and len(rows) == 1 else {}
        labels = row.get("Config", {}).get("Labels") or {}
        cid = row.get("Id", "")
        if (not re.fullmatch(r"[a-f0-9]{64}", cid)
                or labels.get(SCOPE_LABEL) != scope[0]
                or labels.get(LABEL) != os.environ.get(OWNER_ENV)
                or row.get("HostConfig", {}).get("CgroupParent") != scope[0]
                or row.get("State", {}).get("Running") is not True):
            raise Refused("docker exec target is not a running container in this exact PB memory slice")
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        raise Refused(f"cannot verify docker exec container ownership: {exc}") from exc
    # Pin the immutable id after inspection; a recycled container name must not
    # redirect this command into another job between inspect and exec.
    return [*global_options, *sub[:index], cid, *sub[index + 1:]], environment


def _container_intent(scope: str, *, ticket: str | None = None) -> dict:
    # Published fleet tools are flattened; source checkouts retain tools/fleet.
    source = Path(__file__).resolve().parents[1] / "src"
    if not source.is_dir():
        source = Path(__file__).resolve().parents[2] / "src"
    sys.path.insert(0, str(source))
    from prismabuild.resource_scope import BROKER_SOCKET, broker_request
    endpoint = BROKER_SOCKET
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        endpoint = Path(os.environ.get("PRISMABUILD_RESOURCE_SOCKET") or endpoint)
    request = {"op": "container_begin" if ticket is None else "container_end",
               "scope_id": scope}
    if ticket is not None:
        request["ticket"] = ticket
    try:
        response = broker_request(request, socket_path=endpoint)
        if ticket is None and re.fullmatch(r"[a-f0-9]{64}", str(response.get("ticket", ""))) is None:
            raise OSError("broker returned no valid container intent ticket")
        return response
    except (OSError, ValueError) as exc:
        raise Refused(f"cannot register container creation with the PB resource broker: {exc}") from exc


def main() -> int:
    argv = sys.argv[1:]
    owner = os.environ.get(OWNER_ENV, "")
    marker_raw = os.environ.get(MARKER_ENV, "")
    real = _real_docker()
    if not owner and not marker_raw:
        os.execv(real, [real, *argv])
    if len(owner) != 64 or any(ch not in "0123456789abcdef" for ch in owner):
        sys.stderr.write(f"docker shim: {OWNER_ENV} is not a 64-hex digest\n")
        return 125
    if not marker_raw:
        sys.stderr.write(f"docker shim: {MARKER_ENV} is missing\n")
        return 125
    try:
        command = _verb_index(argv, GLOBAL_VALUE_OPTIONS, GLOBAL_FLAGS,
                              what="global")
        sub = [] if command is None else argv[command:]
        unowned = _starts_unowned_container(sub)
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    if unowned:
        sys.stderr.write(
            "docker shim: start/compose-up cannot attach PrismaBuild's owner "
            "label; use docker run/create inside this action\n")
        return 125

    try:
        scope = _resource_scope()
        _refuse_unaccounted_work(sub, scope=scope)
        if scope and (sub[:1] == ["exec"] or sub[:2] == ["container", "exec"]):
            forwarded, environment = _owned_exec(real, argv[:command], sub, scope)
            os.execvpe(real, [real, *forwarded], environment)
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    relative = _creation_index(sub)
    if relative is None:
        os.execv(real, [real, *argv])
    insertion = command + relative
    try:
        creation, options, requested = _container_options(
            argv[insertion:], memory_limit=scope[1] if scope else None)
        cpuset = _reserved_cpuset(requested)
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125
    if _has_reserved_label(options):
        sys.stderr.write(
            f"docker shim: callers may not set the reserved {LABEL} or "
            f"{JOB_LABEL} label\n")
        return 125

    try:
        global_options, environment = _local_daemon(real, argv[:command])
        if scope and global_options[-1] not in {"unix:///var/run/docker.sock", "unix:///run/docker.sock"}:
            raise Refused("PB resource scopes require the local system Docker daemon")
    except Refused as refusal:
        sys.stderr.write(f"docker shim: {refusal}\n")
        return 125

    marker = Path(marker_raw)
    marker.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(marker, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        # Held until the Docker CLI returns or this action is killed.  Cleanup
        # acquires the same lock before querying the daemon, so it cannot race
        # a container creation request still in flight.
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        os.ftruncate(descriptor, 0)
        os.write(descriptor, owner.encode() + b"\n")
        os.fsync(descriptor)
        labels = ["--label", f"{LABEL}={owner}"]
        job = _slurm_job_id()
        if job:
            labels += ["--label", f"{JOB_LABEL}={job}"]
        containment = []
        if scope:
            unit, limit = scope
            labels += ["--label", f"{SCOPE_LABEL}={unit}"]
            memory_options = [value for index, value in enumerate(options)
                              if index and options[index - 1] == "--memory"]
            limit = int(memory_options[-1]) if memory_options else limit
            containment = ["--cgroup-parent", unit, "--memory", str(limit),
                           "--memory-swap", str(limit)]
        labelled = [*global_options, *sub[:relative], *labels, *containment,
                    "--cpuset-cpus", cpuset, *creation]
        try:
            ticket = _container_intent(scope[0])["ticket"] if scope else None
            result = subprocess.run([real, *labelled], env=environment, check=False)
            # Only CLI success proves the daemon operation settled. A nonzero
            # exit can follow a connection failure after daemon acceptance.
            # Retain its pending ticket (also for an ordinary user-command
            # failure), so release keeps a frozen tombstone for late creation.
            if ticket is not None and result.returncode == 0:
                _container_intent(scope[0], ticket=ticket)
            return result.returncode
        except Refused as refusal:
            sys.stderr.write(f"docker shim: {refusal}\n")
            return 125
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    raise SystemExit(main())
