OWNER_ENV = "PRISMABUILD_CONTAINER_OWNER"
MARKER_ENV = "PRISMABUILD_CONTAINER_MARKER"
LABEL = "prismabuild.action"
SCOPE_LABEL = "prismabuild.scope"

#: One label per shim invocation: a random nonce that names the container THIS
#: call created.  The owner label names the action, and an action may run
#: several containers at once, so a stop that must touch exactly one container
#: cannot use it alone (#1599).  Callers may not set it.
SHIM_LABEL = "prismabuild.shim"

#: Termination is relayed to the real client (#1599).  A guard that stops a
#: workload sends TERM to this process, and the container belongs to the
#: daemon, so a shim that only waits ends without stopping it.  The signals
#: the shim forwards, the grace the workload gets before the container is
#: killed, and the wait for the client to follow.  The defaults sit inside the
#: five seconds the campaign guard allows between TERM and its own KILL; an
#: action that runs its own escalation may lengthen them, never past the cap.
RELAYED_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
GRACE_ENV = "PRISMABUILD_DOCKER_STOP_GRACE_S"
KILL_WAIT_ENV = "PRISMABUILD_DOCKER_STOP_KILL_WAIT_S"
DEFAULT_GRACE_S, MAX_GRACE_S = 1.5, 30.0
DEFAULT_KILL_WAIT_S, MAX_KILL_WAIT_S = 0.5, 10.0
#: The ownership query, the kill and the check afterwards share this tail after
#: the grace, and each daemon call is also capped on its own, so a hung daemon
#: cannot stretch the stop: 1.5 s grace + 2.5 s tail = 4 s, inside five.
STOP_TAIL_S = 2.5
DAEMON_CALL_S = 0.8
#: Returned instead of 128+signal when a stop was NOT proved (the container
#: still runs, the daemon could not be asked, or it is not this attempt's).
STOP_FAILED_EXIT = 125
RECEIPT_SCHEMA = "prismabuild.docker_stop_receipt.v1"
SCOPE_RE = re.compile(r"prismabuild-job[a-f0-9]{32}\.slice")

#: A second label naming the SLURM job this container was created inside.
#:
#: The owner label is the action's identity, and under the pull queue that was
#: also one execution: the queue handed a key to one worker at a time.  SLURM
#: has no such claim -- an attached ``pbrun`` re-submits a key that already has
#: a job in flight -- so two jobs of one action can run on one node, share the
#: owner label, and the first job's Epilog removes the second job's containers.
#:
#: The job id is read from this process's kernel-owned cgroup and NOT from the
#: environment: ``proctrack/cgroup`` puts every process of a job under
#: ``job_<id>`` and nothing in the job can move itself out, whereas anything
#: can export a variable.  It is the rule ``core._slurm_job_from_cgroup``
#: already applies to worker attestation, and the regex below is that one.
#: Outside a job cgroup -- the pull queue, a hand-run action -- there is no
#: second label and nothing changes.
JOB_LABEL = "prismabuild.job"
CGROUP_JOB_RE = re.compile(r"(?:^|/)job_([1-9][0-9]*)(?:[./]|$)")

#: The sample guard and its route marker (issue #562).  ``--profile sample``
#: adds both to the action's environment, and this shim refuses a container
#: route under the guard before contacting the daemon: py-spy follows the
#: action's own process tree, and a workload the Docker daemon starts is a
#: child of ``containerd-shim`` rather than of the action.  The route is
#: recorded in the marker *before* the refusal, so a launcher that swallows
#: the ``125`` cannot leave a host-only profile looking like a covered one.
#: The worker arms the marker first; a marker that is missing, incomplete or
#: unreadable is negative coverage, so a write that fails here falls back to
#: leaving the marker absent rather than armed.
SAMPLE_GUARD_ENV = "PRISMABUILD_PROFILE_SAMPLE"
SAMPLE_MARKER_ENV = "PRISMABUILD_PROFILE_SAMPLE_MARKER"
ROUTE_SCHEMA = "prismabuild.profile_container_route.v1"
ROUTE_RECORDED = "route"


def _slurm_job_id() -> str:
    """The job whose cgroup holds this process, or "" when there is not one.

    Silent on every failure by design: a shim that refused to start a container
    because it could not read ``/proc`` would take the pull queue down with it.
    An unreadable or ambiguous cgroup yields no label, which the Epilog reads
    as "not this job's container" and leaves alone -- a leaked container rather
    than somebody else's removed.
    """

    # The path is overridable only under the same testing gate the real docker
    # binary is, and for the same reason: a test cannot give this process a
    # SLURM job cgroup, and nothing in production reads the override.
    path = Path("/proc/self/cgroup")
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        path = Path(os.environ.get("PRISMABUILD_CGROUP_FILE") or path)
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError:
        return ""
    jobs = set()
    for line in raw.splitlines():
        fields = line.split(":", 2)
        if len(fields) != 3:
            continue
        match = CGROUP_JOB_RE.search(fields[2])
        if match is not None:
            jobs.add(match.group(1))
    return jobs.pop() if len(jobs) == 1 else ""


def _real_docker() -> str:
    if os.environ.get("PRISMABUILD_DOCKER_TESTING") == "1":
        return os.environ.get("PRISMABUILD_DOCKER_REAL", "/usr/bin/docker")
    return "/usr/bin/docker"


class Refused(Exception):
    """A command this shim will not hand to Docker, with the reason."""


#: Docker's own global options, which may precede the subcommand.
#:
#: The shim used to read ``argv[0]`` as the subcommand, so every documented
#: spelling that puts an option first hid the command behind it: ``docker
#: --context default run -d IMAGE`` reached the daemon with no owner label, no
#: job label and no marker, and a detached container created that way is one
#: ``pool.cleanup_action_containers`` and the Epilog both query by label and
#: therefore never find.  ``docker --context default start`` and ``docker
#: compose -f f.yml up -d`` escaped the refusals for the same reason.  Options
#: are split by arity because that is the only thing the shim needs from them:
#: where the command begins.
GLOBAL_VALUE_OPTIONS = frozenset({
    "--config", "-c", "--context", "-H", "--host", "-l", "--log-level",
    "--tlscacert", "--tlscert", "--tlskey",
})
GLOBAL_FLAGS = frozenset({
    "-D", "--debug", "--tls", "--tlsverify", "-v", "--version", "-h", "--help",
})

#: Compose's own options, which sit between ``compose`` and its verb.
COMPOSE_VALUE_OPTIONS = frozenset({
    "--ansi", "--env-file", "-f", "--file", "--parallel", "--profile",
    "--progress", "--project-directory", "-p", "--project-name",
})
COMPOSE_FLAGS = frozenset({"--all-resources", "--compatibility", "--dry-run"})

#: Compose verbs that create or start containers.  Compose owns the labels on
#: what it creates, so none of them can carry this action's owner label, and
#: all four are the refusal ``compose up`` already was.
COMPOSE_STARTS = frozenset({"up", "run", "create", "start"})


def _verb_index(argv: list[str], value_options: frozenset[str],
                flags: frozenset[str], *, what: str) -> int | None:
    """Index of the first token past these options, or None if there is none.

    Raises ``Refused`` on an option the shim does not know.  Guessing an
    unknown option's arity is what the old fixed-position read did by
    accident: parse one token out and an image name reads as a subcommand, or
    a ``start`` reads as an option's value.  A refusal names the option and
    the operator adds it to the table above; a guess loses a container.
    """

    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--":
            return index + 1 if index + 1 < len(argv) else None
        if not token.startswith("-") or token == "-":
            return index
        name = token.split("=", 1)[0]
        if name in value_options:
            index += 1 if "=" in token else 2
            continue
        if name in flags:
            index += 1
            continue
        if not token.startswith("--") and token[:2] in value_options:
            index += 1                     # attached: -cdefault, -Hunix:///x
            continue
        raise Refused(
            f"{what} option {token} is not one this shim knows, so it cannot "
            f"tell where the command begins; add it to the shim's option "
            f"table or run this without the option")
    return None


def _creation_index(argv: list[str]) -> int | None:
    """Where a container command's own options begin, or None.

    ``argv`` is the subcommand and everything after it, Docker's globals
    already consumed by the caller.
    """

    if argv and argv[0] in {"run", "create"}:
        return 1
    if len(argv) >= 2 and argv[0] == "container" and argv[1] in {"run", "create"}:
        return 2
    return None


def _starts_unowned_container(argv: list[str]) -> bool:
    """True for a lifecycle form that cannot be given this action's label."""

    if argv and argv[0] == "start":
        return True
    if len(argv) >= 2 and argv[0] == "container" and argv[1] == "start":
        return True
    if argv and argv[0] == "compose":
        verb = _verb_index(argv[1:], COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS,
                           what="compose")
        return verb is not None and argv[1 + verb] in COMPOSE_STARTS
    return False


def _container_route(argv: list[str]) -> str | None:
    """Name the route by which ``argv`` would run workload in a container.

    The set is the one the Nsys refusal already uses: run/create, exec, and
    the start/compose-start forms.  Named rather than boolean because the name
    travels into the profile record, where a reader has only prose to say why
    the sampler could not see the workload.
    """

    creation = _creation_index(argv)
    if creation is not None:
        return " ".join(["docker", *argv[:creation]])
    if argv[:1] == ["exec"]:
        return "docker exec"
    if argv[:2] == ["container", "exec"]:
        return "docker container exec"
    if argv[:1] == ["start"]:
        return "docker start"
    if argv[:2] == ["container", "start"]:
        return "docker container start"
    if argv[:1] == ["compose"]:
        verb = _verb_index(argv[1:], COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS,
                           what="compose")
        if verb is not None and argv[1 + verb] in COMPOSE_STARTS:
            return "docker compose " + argv[1 + verb]
    return None


def _record_sample_route(marker: str, route: str) -> bool:
    """Replace the armed marker with a route record before the refusal.

    The worker arms the marker before the action starts.  A marker that is
    missing, incomplete or unreadable is negative coverage at settlement, so
    this never writes through the marker leaf: the staging inode is created
    exclusively with ``mkstemp`` (a symlink or FIFO planted at a predictable
    staging name is neither followed nor blocked on) and ``os.replace``
    replaces the leaf rather than following it.  If the record cannot be
    installed, the leaf is unlinked -- removing a symlink or FIFO without
    following it -- so the marker ends up negative instead of armed.  Every
    failure is silent; the refusal it belongs to is the caller's job, and the
    return value only says how the record ended.  This is bookkeeping in the
    action's own scratch directory, not a security boundary.
    """

    if not marker:
        return False
    payload = (json.dumps(
        {"schema": ROUTE_SCHEMA, "state": ROUTE_RECORDED, "route": route},
        sort_keys=True,
    ) + "\n").encode()
    path = Path(marker)
    staged = None
    try:
        descriptor, staged = tempfile.mkstemp(
            prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(staged, path)
        return True
    except (OSError, ValueError):
        if staged is not None:
            try:
                os.unlink(staged)
            except OSError:
                pass
        try:
            os.unlink(path)
        except OSError:
            pass
        return False


def _label_values(argv: list[str]):
    """Every ``--label`` value on a container command, however it is spelled.

    ``--label=prismabuild.action`` (a key with no value) and the attached
    ``-lprismabuild.job=9999`` are the same fixed-token assumption the
    subcommand read had: both set a reserved label and neither was seen.
    """

    index = 0
    while index < len(argv):
        token = argv[index]
        if token in {"--label", "-l"}:
            if index + 1 < len(argv):
                yield argv[index + 1]
            index += 2
            continue
        for prefix in ("--label=", "-l=", "-l"):
            if token.startswith(prefix) and len(token) > len(prefix):
                yield token[len(prefix):]
                break
        index += 1


def _has_reserved_label(argv: list[str]) -> bool:
    for value in _label_values(argv):
        if value.split("=", 1)[0] in {LABEL, JOB_LABEL, SCOPE_LABEL, SHIM_LABEL}:
            return True
    return False


