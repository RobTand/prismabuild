[Unit]
Description=PrismaBuild fleet canary, nightly run of the active generation
Documentation=file://%h/prismabuild/docs/self_hosted_runner_canary_2026-09-19.md

[Service]
Type=oneshot
WorkingDirectory=%h/prismabuild
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PBCANARY_GPU_IMAGE=prismaquant-glm-derivative@sha256:c0e532d28a78b3bf425bbbc0d862e2840ba624249162aedfadd09748a6c68c37
ExecStart=/usr/bin/python3 tools/fleet/pbcanary_watch.py --nightly
UMask=0077
