[Unit]
Description=Check and resolve PrismaBuild GitHub issues
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/prismabuild
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_PROMPT_DISABLED=1
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/python3 %h/.local/lib/prismabuild-maintenance/watch_issues.py --checkout %h/prismabuild --state-dir %h/.local/state/prismabuild-maintenance
TimeoutStartSec=infinity
UMask=0077
