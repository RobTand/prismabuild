  {
   "modules": [
    "src/prismabuild/_measurement_reservation.py"
   ],
   "name": "_read",
   "reason": "The measurement census requires bounded no-follow replaced-leaf reads and strict JSON object decoding, with CensusUnavailable for disappearing mandatory records and explicit optional absence. Existing readers tolerate cache or reconciliation failures, validate spool receipts, or return raw bytes; their absence and refusal contracts cannot replace this census boundary."
  },
  {
   "modules": [
    "src/prismabuild/_bounded_reader.py",
    "tools/fleet/pbstatus.py"
   ],
   "name": "bounded",
   "reason": "The private reader owns the fork, deadline and optional persistent ownership handshake. The diagnostic compatibility facade exposes the historical argument surface without ownership callbacks and delegates every effect to that owner; it is not a second reader implementation."
  },
  {
   "modules": [
    "src/prismabuild/_bounded_reader.py",
    "tools/fleet/pbstatus.py"
   ],
   "name": "_reap_within",
   "reason": "The private reader owns actual waitpid reaping. The diagnostic compatibility facade deliberately resolves that owner on each call so existing retained-reader callers and core fault injection share the current boundary, as test_bounded_reader_core_boundary verifies; it contains no independent reaping policy."
  },
  {
   "modules": [
    "tools/fleet/qualify_needrestart_broker_deferral.py"
   ],
   "name": "_fail",
   "reason": "The qualifier's helper prints a refusal to stderr and returns process status 2; core._fail raises its contract error inside library validation, and no caller crosses between those two contracts."
  },
  {
   "modules": [
    "src/prismabuild/container_images.py"
   ],
   "name": "_observe",
   "reason": "container_images._observe probes the local Docker daemon's image inventory under one deadline budget and reports unknown or inventory; produced_spool._observe and stage_move._observe observe filesystem path identity and metadata versions, with different failure modes."
  },
  {
   "modules": [
    "tools/fleet/pbtest_pins.py",
    "tools/maintenance/diag_811_e1_checkout_cache.py"
   ],
   "name": "preflight",
   "reason": "pbtest_pins.preflight is the pytest wrapper's exit-code gate over reviewed dependency pins; diag_811's preflight records a checkout-identity proof as experiment data and maps a failure to ok=false, so the two share only the vocabulary word."
  },
  {
   "modules": [
    "tools/fleet/install_ram_mount_unit.py"
   ],
   "name": "_positive",
   "reason": "The installer converts canonical decimal CLI text and raises argparse.ArgumentTypeError; produced_spool and residency_map validate already-typed domain integers and raise their respective domain errors. Sharing them would change lexical acceptance or error contracts."
  },
  {
   "modules": [
    "src/prismabuild/control_cpu.py",
    "src/prismabuild/gpu_memory.py"
   ],
   "name": "_process_identity",
   "reason": "control_cpu positively classifies kernel threads or qualified control processes using flags, runtime and host attribution; gpu_memory reads a PID start tick and unified cgroup path without attribution. Their return values, inputs and refusal contracts differ."
  },
  {
   "modules": [
    "src/prismabuild/publication_canary.py",
    "tools/maintenance/diag940_contended_observer.py"
   ],
   "name": "identity",
   "reason": "publication_canary validates a declared generation-and-host mapping; the observer reads a live PID incarnation, executable and published worker/source bytes. Their inputs, returned fields and refusal contracts differ, so neither can replace the other."
  },
  {
   "modules": [
    "tools/fleet/migrate_role_logs.py"
   ],
   "name": "_read",
   "reason": "The migration reader returns bounded raw process/runtime observation bytes and raises on transport or size failure. Existing _read helpers parse JSON action/reconciliation/retirement objects, validate spool receipts, or cache resource and census records; their result and absence/error contracts cannot replace this byte observation."
  },
  {
   "modules": [
    "tools/fleet/migrate_role_logs.py"
   ],
   "name": "_observe",
   "reason": "The migration observer qualifies one boot, complete sealed members, supervisor source and three declared PID/incarnation/append-writer contexts. Existing _observe helpers collect Docker image inventory or filesystem path identity/version facts; neither establishes this closed process/source qualification contract."
  },
  {
   "modules": [
    "tools/fleet/migrate_role_logs.py"
   ],
   "name": "run",
   "reason": "The migration consumer returns a closed three-leaf read-only plan or original-FD-only mode change with partial-effect reporting. Existing run helpers execute actions, broker scopes, canary watches, benchmark loops or stage/upgrade operations; their arguments, effects and returned evidence are different."
  },
  {
   "modules": [
    "src/prismabuild/filesystem_floor.py",
    "src/prismabuild/prelaunch_group.py"
   ],
   "name": "census",
   "reason": "The prelaunch group census counts the tokens of one reservation group in the tier ledger, in its private acquisition handles and in its chunk movers. The filesystem floor census reads mounted filesystem trust. The two share a name and no contract."
  },
  {
   "modules": [
    "src/prismabuild/prelaunch_group.py"
   ],
   "name": "reconcile",
   "reason": "The prelaunch group reconcile runs the crash-recovery rule table of one reservation group against the tier ledger and its receipts. Other reconcile helpers repair queue records or host holds. Their inputs and outcomes differ."
  },
  {
   "modules": [
    "src/prismabuild/local_dependencies.py"
   ],
   "name": "observe",
   "reason": "The local dependency observer stats declared absolute paths on this box and answers executable, path, absent or unknown for each one. The capacity and container-image observers read other facts with other answer shapes, so the three share no contract."
  },
  {
   "modules": [
    "src/prismabuild/generation_receipt.py"
   ],
   "name": "observe",
   "reason": "The generation receipt observer reads one runtime commit and generation pair, preserving missing, unreadable, malformed and incomplete answers. Capacity observes host resource bounds, container images observes Docker inventory and local dependencies observes declared paths. Those observers cannot answer the receipt identity question."
  },
  {
   "modules": [
    "src/prismabuild/container_images.py",
    "src/prismabuild/local_dependencies.py"
   ],
   "name": "missing",
   "reason": "The container-image helper subtracts a present set from required image names. The local dependency helper compares declared path kinds with a worker's per-path answers and fails closed on an unreadable answer. The inputs, domains and results differ."
  },
  {
   "modules": [
    "tools/backlog_census/hindsight.py"
   ],
