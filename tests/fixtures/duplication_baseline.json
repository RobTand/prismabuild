   ],
   "name": "save",
   "reason": "Hindsight saves identity-bound sorted JSON receipts through process-specific temporary names. Issue watching saves unsorted polling state through a fixed temporary suffix; sharing that writer would change historical receipt bytes or concurrent-write behavior."
  },
  {
   "modules": [
    "tools/backlog_census/census.py",
    "tools/fleet/pbresident.py"
   ],
   "name": "timestamp",
   "reason": "Census timestamps normalize to aware UTC datetime objects and reject invalid evidence with ValueError. Resident lease arguments return epoch seconds and report argparse errors; their result and boundary contracts differ."
